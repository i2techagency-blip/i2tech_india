(()=>{'use strict';const root=document.querySelector('.wsc-eg-case');if(!root)return;const reduce=matchMedia('(prefers-reduced-motion: reduce)');let io=null;function reveal(){if(io)io.disconnect();root.classList.remove('eg-motion');root.querySelectorAll('.eg-observe').forEach(el=>el.classList.remove('eg-observe','eg-visible'));if(reduce.matches||!('IntersectionObserver'in window))return;const targets=[...root.querySelectorAll('.section-head,.three-col article,.detail-grid article,.outcome')];targets.forEach(el=>{el.classList.add('eg-observe');if(el.getBoundingClientRect().top<innerHeight)el.classList.add('eg-visible')});io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('eg-visible');io.unobserve(e.target)}}),{threshold:.08});targets.forEach(el=>io.observe(el));root.classList.add('eg-motion')}reveal();reduce.addEventListener('change',reveal);const card=root.querySelector('.hero-visual');if(card&&matchMedia('(hover:hover) and (pointer:fine)').matches){let frame=0;card.addEventListener('pointermove',e=>{if(reduce.matches||innerWidth<901)return;cancelAnimationFrame(frame);const r=card.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;frame=requestAnimationFrame(()=>{card.style.transform=`perspective(1400px) rotateY(${x*5-3}deg) rotateX(${-y*4}deg)`})});card.addEventListener('pointerleave',()=>{cancelAnimationFrame(frame);card.style.transform=''})}})();
